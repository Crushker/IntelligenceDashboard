# ─────────────────────────────────────────────────────────────────────────────
# NBFC Intelligence Platform - Environment Configuration
# Copy to .env and fill in actual values for production deployment
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
ALLOWED_HOSTS=api.nbfcintel.in,localhost
CORS_ORIGINS=https://app.nbfcintel.in,https://www.nbfcintel.in

# ─── Database (PostgreSQL 16) ───────────────────────────────────────────────
DB_USER=nbfc_intel_admin
DB_PASSWORD=<GENERATE_STRONG_PASSWORD_32_CHARS>
DB_NAME=nbfc_intelligence
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=<GENERATE_STRONG_PASSWORD>

# ─── Celery ─────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/1
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/2

# ─── Security ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=<GENERATE_64_CHAR_HEX_STRING>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Argon2id password hashing parameters
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Data encryption key (AES-256) for DPDP compliance
# Generate with: openssl rand -hex 32
DATA_ENCRYPTION_KEY=<GENERATE_64_CHAR_HEX_STRING>

# ─── LLM Configuration ─────────────────────────────────────────────────────
# OpenAI (primary analysis engine)
OPENAI_API_KEY=sk-<YOUR_OPENAI_API_KEY>
LLM_MODEL=gpt-4-turbo-preview
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Anthropic (fallback/consensus)
ANTHROPIC_API_KEY=sk-ant-<YOUR_ANTHROPIC_API_KEY>

# ─── YouTube Data API ───────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=<YOUR_YOUTUBE_DATA_API_V3_KEY>

# ─── Email (SMTP / Amazon SES) ─────────────────────────────────────────────
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=<SES_SMTP_USERNAME>
SMTP_PASSWORD=<SES_SMTP_PASSWORD>
SMTP_FROM_EMAIL=intelligence@nbfcintel.in
SES_REGION=ap-south-1

# ─── DPDP Act 2023 Compliance ──────────────────────────────────────────────
CONSENT_RECORDING_ENABLED=true
RIGHT_TO_ERASURE_ENABLED=true
DATA_RETENTION_DAYS=365
ANONYMIZATION_ENABLED=true

# ─── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_API=60/minute

# ─── SSO / OIDC Configuration ──────────────────────────────────────────────
# Microsoft Entra ID (Azure AD)
MICROSOFT_CLIENT_ID=<YOUR_ENTRA_APP_CLIENT_ID>
MICROSOFT_CLIENT_SECRET=<YOUR_ENTRA_APP_SECRET>
MICROSOFT_TENANT_ID=<YOUR_TENANT_ID>

# Google Workspace
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_OAUTH_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_OAUTH_SECRET>

# ─── Webhook / Integration ──────────────────────────────────────────────────
SLACK_SIGNING_SECRET=<YOUR_SLACK_APP_SIGNING_SECRET>
TEAMS_APP_ID=<YOUR_TEAMS_APP_ID>

# ─── Monitoring & Observability ─────────────────────────────────────────────
SENTRY_DSN=https://<key>@sentry.io/<project>
PROMETHEUS_ENABLED=true
GRAFANA_ADMIN_PASSWORD=<GENERATE_PASSWORD>

# ─── Backup & DR ────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=<AWS_IAM_ACCESS_KEY>
AWS_SECRET_ACCESS_KEY=<AWS_IAM_SECRET_KEY>
S3_BACKUP_BUCKET=nbfc-intel-backups-ap-south-1
BACKUP_ENCRYPTION_KEY=<GENERATE_KEY>
RPO_HOURS=1
RTO_HOURS=4

# ─── Feature Flags ──────────────────────────────────────────────────────────
ENABLE_VIDEO_TRANSCRIPT_ANALYSIS=true
ENABLE_ZKP_RESEARCH_TRACKING=true
ENABLE_PQC_MIGRATION_ALERTS=true
ENABLE_ACCOUNT_AGGREGATOR_MONITORING=true
