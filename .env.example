# ─────────────────────────────────────────────────────────────────────────────
# NBFC Intelligence Platform - Environment Configuration
# Copy this file to .env and fill in all required values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
ALLOWED_HOSTS=["nbfcintel.in", "www.nbfcintel.in", "api.nbfcintel.in"]
CORS_ORIGINS=["https://nbfcintel.in", "https://www.nbfcintel.in", "https://app.nbfcintel.in"]

# ─── Database (PostgreSQL 16) ───────────────────────────────────────────────
DB_USER=nbfc_intel_admin
DB_PASSWORD=<generate-strong-64-char-password>
DB_NAME=nbfc_intelligence
DATABASE_URL=postgresql+asyncpg://nbfc_intel_admin:<password>@postgres:5432/nbfc_intelligence
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://:<redis-password>@redis:6379/0
REDIS_PASSWORD=<generate-strong-32-char-password>

# ─── Security ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET_KEY=<generate-64-byte-hex-secret>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Argon2id parameters (enterprise-grade)
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Data encryption key for sensitive fields (DPDP compliance)
DATA_ENCRYPTION_KEY=<generate-32-byte-hex-key>

# ─── LLM Configuration ─────────────────────────────────────────────────────
# OpenAI (for intelligence analysis)
OPENAI_API_KEY=sk-<your-openai-api-key>
LLM_MODEL=gpt-4-turbo-preview
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Anthropic (alternative)
ANTHROPIC_API_KEY=sk-ant-<your-anthropic-api-key>

# ─── YouTube Data API ───────────────────────────────────────────────────────
YOUTUBE_API_KEY=<your-youtube-data-api-v3-key>

# ─── Email (SMTP / Amazon SES) ─────────────────────────────────────────────
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=<ses-smtp-username>
SMTP_PASSWORD=<ses-smtp-password>
SMTP_FROM_EMAIL=intelligence@nbfcintel.in
SES_REGION=ap-south-1

# ─── Celery ─────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:<redis-password>@redis:6379/1
CELERY_RESULT_BACKEND=redis://:<redis-password>@redis:6379/2

# ─── DPDP Compliance ────────────────────────────────────────────────────────
CONSENT_RECORDING_ENABLED=true
RIGHT_TO_ERASURE_ENABLED=true

# ─── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute

# ─── API URLs ───────────────────────────────────────────────────────────────
API_URL=https://api.nbfcintel.in
FRONTEND_URL=https://app.nbfcintel.in
